<?xml version="1.0" encoding="UTF-8"?>
<!-- The level of our own classes can be changed with -Dworkshop.log.level=warn (or debug, error, off) -->
<Configuration status="warn">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %logger{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="patmal.workshops.student.impl" level="${sys:workshop.log.level:-info}"/>
        <Root level="warn">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
